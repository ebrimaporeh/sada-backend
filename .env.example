# ─── Core ────────────────────────────────────────────────────────────────────
SECRET_KEY=your-super-secret-key-change-this-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ─── Environment ─────────────────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=settings.development

# ─── Database ────────────────────────────────────────────────────────────────
# SQLite (default for development)
# SQLite path is set automatically from BASE_DIR - only override for PostgreSQL/MySQL
# DATABASE_URL=postgres://user:password@host:5432/dbname

# PostgreSQL (production)
# DATABASE_URL=postgres://user:password@host:5432/dbname

# MySQL (production)
# DATABASE_URL=mysql://user:password@host:3306/dbname

# ─── Frontend ────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Production only (settings/production.py) -- cookie-authenticated requests
# (Django admin, allauth) from these origins are trusted for CSRF. Defaults
# to CORS_ALLOWED_ORIGINS above if unset; override only if they need to differ.
# CSRF_TRUSTED_ORIGINS=https://app.example.com

# ─── Email (Resend, via django-anymail) ─────────────────────────────────────
# Every environment (local dev, testing, production) sends through Resend's
# HTTPS API - PaaS hosts like Railway block outbound SMTP entirely, so there
# is no SMTP fallback. Get RESEND_API_KEY from https://resend.com/api-keys;
# RESEND_API_NAME is just a human-readable label, not read by Anymail itself.
RESEND_API_NAME=your-resend-account-name
RESEND_API_KEY=your-resend-api-key

DEFAULT_FROM_EMAIL=Your App <noreply@yourapp.com>
EMAIL_REPLY_TO=support@yourapp.com

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ─── Rate Limiting ───────────────────────────────────────────────────────────
API_RATE_LIMIT_ANON=100/hour
API_RATE_LIMIT_USER=1000/hour

# ─── Redis / Celery (uncomment when using background tasks) ──────────────────
# REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ─── Storage (Supabase Storage, S3-compatible; uncomment to enable) ──────────
# Falls back to local disk when SUPABASE_STORAGE_BUCKET is unset -- fine for
# local dev, but Railway's filesystem is ephemeral, so anything deployed
# there needs this configured. See settings/base.py and utils/storage.py.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_STORAGE_ENDPOINT=https://your-project.supabase.co/storage/v1/s3
# SUPABASE_STORAGE_REGION=eu-west-1
# SUPABASE_STORAGE_ACCESS_KEY_ID=
# SUPABASE_STORAGE_SECRET_ACCESS_KEY=
# SUPABASE_STORAGE_ADDRESSING_STYLE=path
# SUPABASE_STORAGE_QUERYSTRING_AUTH=False
#
# Public bucket -- avatars, campaign images, category images, org logos, etc.
# SUPABASE_STORAGE_BUCKET=media
#
# Separate PRIVATE bucket for organization verification documents
# (registration certificates, the org photo submitted with them). Must be a
# different, non-public bucket in the same Supabase project -- never reuse
# SUPABASE_STORAGE_BUCKET here. Reads the same credentials/endpoint above;
# only the bucket name and its public/private-ness differ.
# SUPABASE_VERIFICATION_BUCKET=verification-documents

# ─── Site Settings ───────────────────────────────────────────────────────────
SITE_NAME=Dolelma
SITE_DESCRIPTION=Crowdfunding for The Gambia
CONTACT_EMAIL=support@yourapp.com

# ─── Payment gateways ────────────────────────────────────────────────────────
# Credentials only - whether a gateway is actually offered (and, for Stripe,
# the settlement currency + GMD exchange rate) is admin-editable from the
# Settings page (PlatformSettings.modempay_enabled / stripe_enabled /
# stripe_settlement_currency / gmd_to_settlement_rate), not an env var.
DEMO_MODE=True

# ModemPay - mobile money (Wave/APS), donations and payouts.
MODEMPAY_SECRET_API_KEY=
MODEMPAY_PUBLIC_API_KEY=
MODEMPAY_WEBHOOK_SECRET=
MODEMPAY_MERCHANT_ID=

# Stripe - card donations only, no payout path (see
# services/gateways/stripe_gateway.py). Configure these, then enable Stripe
# from the admin Settings page.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
